; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Tree  IDLE TD"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
App="*res://scripts/autoload/app.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
SettingsService="*res://scripts/autoload/settings_service.gd"
LocaleService="*res://scripts/autoload/locale_service.gd"
AudioService="*res://scripts/autoload/audio_service.gd"
ToastService="*res://scripts/autoload/toast_service.gd"
SaveService="*res://scripts/autoload/save_service.gd"
GameState="*res://scripts/autoload/game_state.gd"
WalletService="*res://scripts/economy/wallet_service.gd"
LevelService="*res://scripts/economy/level_service.gd"
UnlockService="*res://scripts/economy/unlock_service.gd"
RunState="*res://scripts/autoload/run_state.gd"
ModifierService="*res://scripts/autoload/modifier_service.gd"
TimeService="*res://scripts/autoload/time_service.gd"
RngService="*res://scripts/autoload/rng_service.gd"
WorkshopService="*res://scripts/economy/workshop_service.gd"
MagicaService="*res://scripts/economy/magica_service.gd"
CardService="*res://scripts/economy/card_service.gd"
MissionService="*res://scripts/economy/mission_service.gd"
OfflineService="*res://scripts/economy/offline_service.gd"
LeaderboardService="*res://scripts/platform/leaderboard_service.gd"
AdsService="*res://scripts/platform/ads_service.gd"
IapService="*res://scripts/platform/iap_service.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.uk.translation")
locale/fallback="en"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
