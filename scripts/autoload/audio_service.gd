## AudioService — music, pooled SFX and bus volumes (autoload).
##
## Owns the only music player (so music never restarts on a scene change),
## a 16-voice SFX pool with a 40 ms per-sound cooldown and ±5 % pitch, an 0.8 s
## crossfade, a −6 dB duck while a modal is open, and a resume on focus.
##
## Placeholder streams are generated by tools/generate_audio_placeholders.py.
## Screens request sounds by id (`play_ui("ui_click")`, `play_sfx_id("crit")`),
## and the service also subscribes to EventBus facts so every existing gameplay
## event gets a sound without copying code into entities.
extends Node

const BUS_MASTER := &"Master"
const BUS_MUSIC := "Music"
const BUS_SFX := "SFX"
const BUS_UI := "UI"

const MUSIC_FADE_SECONDS := 0.8
const DUCK_DB := -6.0
const MAX_SFX_VOICES := 16
const SFX_COOLDOWN_MSEC := 40
const PITCH_VARIATION := 0.05
const SILENT_DB := -40.0

const MUSIC_PATHS: Dictionary = {
	&"menu": "res://assets/audio/music/menu_theme.wav",
	&"battle": "res://assets/audio/music/battle_theme.wav",
	&"boss": "res://assets/audio/music/boss_theme.wav",
}

const SFX_PATHS: Dictionary = {
	&"ui_click": "res://assets/audio/ui/ui_click.wav",
	&"ui_back": "res://assets/audio/ui/ui_back.wav",
	&"ui_toggle": "res://assets/audio/ui/ui_toggle.wav",
	&"ui_error": "res://assets/audio/ui/ui_error.wav",
	&"ui_purchase": "res://assets/audio/ui/ui_purchase.wav",
	&"ui_claim": "res://assets/audio/ui/ui_claim.wav",
	&"card_flip": "res://assets/audio/ui/card_flip.wav",
	&"wave_start": "res://assets/audio/battle/wave_start.wav",
	&"wave_clear": "res://assets/audio/battle/wave_clear.wav",
	&"boss_roar": "res://assets/audio/battle/boss_roar.wav",
	&"tree_hurt": "res://assets/audio/battle/tree_hurt.wav",
	&"enemy_leak": "res://assets/audio/battle/enemy_leak.wav",
	&"enemy_die": "res://assets/audio/battle/enemy_die.wav",
	&"hit_flesh": "res://assets/audio/battle/hit_flesh.wav",
	&"hit_armor": "res://assets/audio/battle/hit_armor.wav",
	&"crit": "res://assets/audio/battle/crit.wav",
	&"shoot_arrow": "res://assets/audio/battle/shoot_arrow.wav",
	&"shoot_cannon": "res://assets/audio/battle/shoot_cannon.wav",
	&"shoot_frost": "res://assets/audio/battle/shoot_frost.wav",
	&"shoot_magic": "res://assets/audio/battle/shoot_magic.wav",
	&"tower_build": "res://assets/audio/battle/tower_build.wav",
	&"tower_upgrade": "res://assets/audio/battle/tower_upgrade.wav",
	&"tower_sell": "res://assets/audio/battle/tower_sell.wav",
	&"upgrade_buy": "res://assets/audio/battle/upgrade_buy.wav",
	&"run_defeat": "res://assets/audio/battle/run_defeat.wav",
	&"research_start": "res://assets/audio/meta/research_start.wav",
	&"research_complete": "res://assets/audio/meta/research_complete.wav",
	&"coin_gain": "res://assets/audio/meta/coin_gain.wav",
	&"gem_gain": "res://assets/audio/meta/gem_gain.wav",
	&"level_up": "res://assets/audio/meta/level_up.wav",
}

const UI_SOUNDS: Array[StringName] = [
	&"ui_click", &"ui_back", &"ui_toggle", &"ui_error",
	&"ui_purchase", &"ui_claim", &"card_flip",
]

var _music_player: AudioStreamPlayer
var _music_id: StringName = &""
var _music_generation: int = 0
var _initialized: bool = false
var _ducked: bool = false
var _modal_open: bool = false

var _music_streams: Dictionary = {}
var _sfx_streams: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _voice_stream: Dictionary = {}
var _last_played_msec: Dictionary = {}


func _ready() -> void:
	_ensure_buses()
	_ensure_music_player()
	_load_streams()
	_bind_events()


## Connects settings and applies current bus volumes. Safe to call twice.
func init_service() -> void:
	if _initialized:
		return
	_initialized = true
	_ensure_buses()
	_ensure_music_player()
	_load_streams()
	_apply_settings()
	if not SettingsService.changed.is_connected(_on_setting_changed):
		SettingsService.changed.connect(_on_setting_changed)


# --- bus volumes ---------------------------------------------------------------

## dB for a linear 0..1 volume; 0 maps to −80 dB (muted).
static func volume_to_db(linear: float) -> float:
	return AudioMath.volume_to_db(linear)


## Sets a bus volume from a linear 0..1 value. Mutes at 0, otherwise uses dB.
func set_bus_volume(bus: StringName, linear: float) -> void:
	var index := AudioServer.get_bus_index(bus)
	if index == -1:
		push_warning("AudioService: bus '%s' does not exist" % bus)
		return
	var value := clampf(linear, 0.0, 1.0)
	AudioServer.set_bus_mute(index, value <= 0.001)
	if value > 0.001:
		AudioServer.set_bus_volume_db(index, volume_to_db(value))


# --- music ---------------------------------------------------------------------

## Crossfades to a named track: menu, battle or boss.
func play_music_id(track: StringName, fade: float = MUSIC_FADE_SECONDS) -> void:
	if _music_id == track and _music_player != null and _music_player.playing:
		return
	var stream: AudioStream = _music_streams.get(track, null)
	if stream == null:
		push_warning("AudioService: unknown music track '%s'" % track)
		return
	_music_id = track
	await play_music(stream, fade)


## Crossfades to `stream`. Passing null stops the current music.
func play_music(stream: AudioStream, fade: float = MUSIC_FADE_SECONDS) -> void:
	if stream == null:
		await stop_music(fade)
		return
	_ensure_music_player()
	if _music_player.stream == stream and _music_player.playing:
		return
	_music_generation += 1
	var generation := _music_generation
	if _music_player.playing and fade > 0.0:
		var fade_out := create_tween()
		fade_out.tween_property(_music_player, "volume_db", SILENT_DB, fade * 0.5)
		await fade_out.finished
		if generation != _music_generation:
			return
	_music_player.stream = stream
	_music_player.volume_db = SILENT_DB if fade > 0.0 else _music_volume_db()
	_music_player.play()
	if fade > 0.0:
		var fade_in := create_tween()
		fade_in.tween_property(_music_player, "volume_db", _music_volume_db(), fade * 0.5)


## Fades out and stops the current music.
func stop_music(fade: float = 0.5) -> void:
	_music_generation += 1
	_music_id = &""
	_ensure_music_player()
	if not _music_player.playing:
		return
	var generation := _music_generation
	if fade > 0.0:
		var fade_out := create_tween()
		fade_out.tween_property(_music_player, "volume_db", SILENT_DB, fade)
		await fade_out.finished
		if generation != _music_generation:
			return
	_music_player.stop()
	_music_player.stream = null


## Returns the id of the track that is currently assigned ("" when stopped).
func current_music_id() -> StringName:
	return _music_id


## True while a modal is ducking the music (used by tests).
func is_ducked() -> bool:
	return _ducked


## Called by Modal on open/close: lowers music by −6 dB while a modal is visible.
func set_modal_open(open: bool) -> void:
	if _modal_open == open:
		return
	_modal_open = open
	_ducked = open
	if _music_player == null or not _music_player.playing:
		return
	var target := _music_volume_db()
	if open:
		target += DUCK_DB
	var tween := create_tween()
	tween.tween_property(_music_player, "volume_db", target, 0.15)


# --- SFX -----------------------------------------------------------------------

## Plays a named one-shot SFX through the pool. `bus` selects SFX or UI.
func play_sfx_id(sound: StringName, pitch_variation: float = PITCH_VARIATION) -> void:
	var stream: AudioStream = _sfx_streams.get(sound, null)
	if stream == null:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played_msec.get(sound, -SFX_COOLDOWN_MSEC)) < SFX_COOLDOWN_MSEC:
		return
	_last_played_msec[sound] = now
	var bus := BUS_UI if UI_SOUNDS.has(sound) else BUS_SFX
	_play_on_voice(stream, bus, pitch_variation)


## Plays a UI sound by id (default click) on the UI bus.
func play_ui(sound: StringName = &"ui_click") -> void:
	play_sfx_id(sound, 0.02)


## Compatibility helper used by early screens: plays an arbitrary stream.
func play_sfx(stream: AudioStream, pitch_variation: float = PITCH_VARIATION) -> void:
	if stream == null:
		return
	_play_on_voice(stream, BUS_SFX, pitch_variation)


## Number of pooled voices (max 16).
func voice_count() -> int:
	return _voices.size()


## Light haptic pulse (Android only; no-op on desktop and when disabled).
func haptic(milliseconds: int) -> void:
	if not SettingsService.haptics:
		return
	if OS.get_name() == "Android":
		Input.vibrate_handheld(milliseconds)


# --- internals -----------------------------------------------------------------

func _play_on_voice(stream: AudioStream, bus: StringName, pitch_variation: float) -> void:
	if stream == null:
		return
	_ensure_pool()
	var voice := _free_voice()
	voice.stream = stream
	voice.bus = bus
	voice.volume_db = 0.0
	voice.pitch_scale = 1.0 + randf_range(-pitch_variation, pitch_variation)
	voice.play()


func _ensure_pool() -> void:
	while _voices.size() < MAX_SFX_VOICES:
		var player := AudioStreamPlayer.new()
		player.name = "SfxVoice%d" % _voices.size()
		add_child(player)
		player.finished.connect(_on_voice_finished.bind(player))
		_voices.append(player)


func _free_voice() -> AudioStreamPlayer:
	for voice: AudioStreamPlayer in _voices:
		if not voice.playing:
			return voice
	# All 16 are busy: steal the first (oldest) voice.
	_voices[0].stop()
	return _voices[0]


func _on_voice_finished(player: AudioStreamPlayer) -> void:
	player.stream = null


func _music_volume_db() -> float:
	return 0.0 + (DUCK_DB if _modal_open else 0.0)


func _ensure_buses() -> void:
	_ensure_bus(BUS_MUSIC)
	_ensure_bus(BUS_SFX)
	_ensure_bus(BUS_UI)


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	var index := AudioServer.bus_count
	AudioServer.add_bus(index)
	AudioServer.set_bus_name(index, bus_name)
	AudioServer.set_bus_send(index, BUS_MASTER)


func _ensure_music_player() -> void:
	if _music_player != null and is_instance_valid(_music_player):
		return
	_music_player = AudioStreamPlayer.new()
	_music_player.name = "MusicPlayer"
	_music_player.bus = BUS_MUSIC
	add_child(_music_player)


func _load_streams() -> void:
	if _music_streams.is_empty():
		for track: StringName in MUSIC_PATHS.keys():
			var stream := load(str(MUSIC_PATHS[track])) as AudioStream
			if stream is AudioStreamWAV:
				var wav := stream as AudioStreamWAV
				wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
				wav.loop_end = int(wav.get_length() * wav.mix_rate)
			_music_streams[track] = stream
	if _sfx_streams.is_empty():
		for sound: StringName in SFX_PATHS.keys():
			_sfx_streams[sound] = load(str(SFX_PATHS[sound])) as AudioStream


func _apply_settings() -> void:
	set_bus_volume(BUS_MASTER, SettingsService.master_volume)
	set_bus_volume(BUS_MUSIC, SettingsService.music_volume)
	set_bus_volume(BUS_SFX, SettingsService.sfx_volume)
	set_bus_volume(BUS_UI, SettingsService.ui_volume)


func _on_setting_changed(key: StringName) -> void:
	match key:
		&"master":
			set_bus_volume(BUS_MASTER, SettingsService.master_volume)
		&"music":
			set_bus_volume(BUS_MUSIC, SettingsService.music_volume)
		&"sfx":
			set_bus_volume(BUS_SFX, SettingsService.sfx_volume)
		&"ui":
			set_bus_volume(BUS_UI, SettingsService.ui_volume)


# --- event hooks ---------------------------------------------------------------

func _bind_events() -> void:
	var bus := get_node_or_null("/root/EventBus")
	if bus == null:
		return
	_connect_bus(bus, &"scene_changed", _on_scene_changed)
	_connect_bus(bus, &"run_started", _on_run_started)
	_connect_bus(bus, &"run_ended", _on_run_ended)
	_connect_bus(bus, &"wave_started", _on_wave_started)
	_connect_bus(bus, &"wave_cleared", _on_wave_cleared)
	_connect_bus(bus, &"boss_spawned", _on_boss_spawned)
	_connect_bus(bus, &"boss_removed", _on_boss_removed)
	_connect_bus(bus, &"tower_built", _on_tower_built)
	_connect_bus(bus, &"enemy_killed", _on_enemy_killed)
	_connect_bus(bus, &"enemy_leaked", _on_enemy_leaked)
	_connect_bus(bus, &"damage_dealt", _on_damage_dealt)
	_connect_bus(bus, &"card_dropped", _on_card_dropped)
	_connect_bus(bus, &"level_up", _on_level_up)
	_connect_bus(bus, &"meta_purchased", _on_meta_purchased)
	_connect_bus(bus, &"research_started", _on_research_started)
	_connect_bus(bus, &"research_completed", _on_research_completed)


func _connect_bus(bus: Node, signal_name: StringName, callable: Callable) -> void:
	if not bus.is_connected(signal_name, callable):
		bus.connect(signal_name, callable)


func _on_scene_changed(scene_id: StringName) -> void:
	_bind_scene_buttons.call_deferred()
	if scene_id == &"battle":
		play_music_id(&"battle")
	else:
		play_music_id(&"menu")


func _on_run_started() -> void:
	play_music_id(&"battle")


func _on_run_ended(_waves: int) -> void:
	play_music_id(&"menu")


func _on_wave_started(_wave: int, is_boss: bool) -> void:
	play_sfx_id(&"wave_start")
	if is_boss:
		play_music_id(&"boss")


func _on_wave_cleared(_wave: int) -> void:
	play_sfx_id(&"wave_clear")


func _on_boss_spawned() -> void:
	play_sfx_id(&"boss_roar")
	haptic(40)
	play_music_id(&"boss")


func _on_boss_removed() -> void:
	play_music_id(&"battle")


func _on_tower_built(_tower_id: StringName, _count: int) -> void:
	play_sfx_id(&"tower_build")


func _on_enemy_killed(_enemy_id: StringName, _is_boss: bool) -> void:
	play_sfx_id(&"enemy_die")


func _on_enemy_leaked(_enemy_id: StringName) -> void:
	play_sfx_id(&"enemy_leak")
	haptic(30)


func _on_damage_dealt(_source_id: StringName, target_id: int, _amount: float, is_crit: bool, _is_kill: bool) -> void:
	if target_id == 0:
		play_sfx_id(&"tree_hurt")
	elif is_crit:
		play_sfx_id(&"crit")
	else:
		play_sfx_id(&"hit_flesh")


func _on_card_dropped(_card_id: StringName) -> void:
	play_ui(&"card_flip")
	play_ui(&"ui_claim")


func _on_level_up(_level: int) -> void:
	play_ui(&"level_up")
	play_ui(&"coin_gain")


func _on_meta_purchased(kind: StringName, _amount: int, _reason: StringName) -> void:
	play_ui(&"ui_purchase")
	if kind == &"gems":
		play_ui(&"gem_gain")


func _on_research_started(_node_id: StringName) -> void:
	play_ui(&"research_start")


func _on_research_completed(_node_id: StringName) -> void:
	play_ui(&"research_complete")


## Connects every Button under `root` to the default click sound. Screens with
## dynamically rebuilt rows call this again after a rebuild (idempotent).
func bind_buttons(root: Node) -> void:
	if root != null:
		_bind_buttons_recursive(root)


## Connects every Button in the current scene to the default click sound.
func _bind_scene_buttons() -> void:
	var scene := get_tree().current_scene
	if scene == null:
		return
	_bind_buttons_recursive(scene)


func _bind_buttons_recursive(node: Node) -> void:
	if node is Button:
		var button := node as Button
		if not button.has_meta(&"audio_bound"):
			button.set_meta(&"audio_bound", true)
			button.pressed.connect(_on_button_pressed.bind(button))
	for child: Node in node.get_children():
		_bind_buttons_recursive(child)


func _on_button_pressed(button: Button) -> void:
	haptic(10)
	var sound: StringName = &"ui_click"
	if button.has_meta(&"audio_sound"):
		sound = StringName(str(button.get_meta(&"audio_sound")))
	elif button.name.to_lower().contains("back"):
		sound = &"ui_back"
	elif button is CheckButton or button is CheckBox:
		sound = &"ui_toggle"
	play_ui(sound)


func _notification(what: int) -> void:
	match what:
		NOTIFICATION_APPLICATION_FOCUS_IN, NOTIFICATION_APPLICATION_RESUMED:
			if _music_player != null and _music_player.stream != null:
				_music_player.stream_paused = false
				if not _music_player.playing:
					_music_player.play()
		NOTIFICATION_APPLICATION_PAUSED:
			if _music_player != null:
				_music_player.stream_paused = true
