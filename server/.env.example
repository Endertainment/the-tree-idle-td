# Copy to server/.env (never commit .env) and adjust.
# Local default: SQLite through aiosqlite; no service needed.
DATABASE_URL=sqlite+aiosqlite:///./thetree.db

# Neon/PostgreSQL: pooled connection string with TLS.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@EP-xxxx-pooler.eu-central-1.aws.neon.tech/thetree?ssl=require

# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Anti-cheat: when set, POST /tournaments/current/submit and /runs require a
# matching HMAC-SHA256 `signature` over "run_seed|waves|duration|damage|cash".
# Leave empty for local development (signature optional, still stored).
RUN_HMAC_SECRET=

# AdMob server-side verification (SSV) shared secret. Empty disables /ads/ssv.
ADMOB_SSV_SECRET=dev-ssv-secret
SSV_MAX_SKEW_SECONDS=600

# "stub" accepts non-empty purchase tokens and marks them verified_by=stub.
# Set to "disabled" to return 503 until a real Play/App Store verifier exists.
PURCHASES_MODE=stub

# Rate limiting is in-process (single uvicorn worker).
RATE_LIMIT_ENABLED=true

# Optional JSON object deep-merged over the built-in remote config.
REMOTE_CONFIG_JSON={}

# Create all tables on startup (create_all bootstrap). Alembic is the formal path.
AUTO_CREATE_TABLES=true
