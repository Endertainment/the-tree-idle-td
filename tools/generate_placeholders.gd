extends SceneTree
## Generates flat-color placeholder art from docs/art_manifest.json.
##
## Run:  godot --headless --path . --script res://tools/generate_placeholders.gd
##
## Rules (spec section 9.2):
##  - idempotent: an existing file is never overwritten (that is how real art is protected);
##  - one solid colour per asset, 2 px darker border, 1 px guides on 9-slice cuts;
##  - also writes assets/art/_missing.png and docs/ART_MANIFEST.md.
##
## Shadow / glow assets get 35 % alpha so they do not read as black rectangles.

const MANIFEST_PATH := "res://docs/art_manifest.json"
const ART_ROOT := "res://assets/art"
const MISSING_PATH := "res://assets/art/_missing.png"
const MD_PATH := "res://docs/ART_MANIFEST.md"

var created := 0
var skipped := 0
var failed := 0


func _initialize() -> void:
	print("[placeholders] manifest: ", MANIFEST_PATH)
	var text := FileAccess.get_file_as_string(MANIFEST_PATH)
	if text.is_empty():
		push_error("Cannot read %s" % MANIFEST_PATH)
		quit(1)
		return

	var data: Variant = JSON.parse_string(text)
	if typeof(data) != TYPE_ARRAY:
		push_error("Manifest is not a JSON array")
		quit(1)
		return

	var entries: Array = data
	_ensure_dir(ART_ROOT)
	_write_missing()

	for raw in entries:
		var e: Dictionary = raw
		var rel: String = str(e.get("path", ""))
		var w: int = int(float(e.get("w", 0)))
		var h: int = int(float(e.get("h", 0)))
		var col := Color.from_string(str(e.get("color", "#FF00FF")), Color.MAGENTA)
		var mode: String = str(e.get("mode", "plain"))
		var margins: Array = e.get("margins", [])

		if rel.is_empty() or w <= 0 or h <= 0:
			push_error("Bad manifest entry: %s" % str(e))
			failed += 1
			continue

		var path := ART_ROOT.path_join(rel)
		if FileAccess.file_exists(path):
			skipped += 1
			continue

		var img := _make_image(rel, w, h, col, mode, margins)
		_ensure_dir(path.get_base_dir())
		var err := img.save_png(path)
		if err != OK:
			push_error("save_png failed for %s (err %d)" % [path, err])
			failed += 1
			continue
		created += 1

	print("[placeholders] created %d, skipped %d, failed %d (total %d)" % [created, skipped, failed, entries.size()])
	if failed == 0:
		_write_markdown(entries)
	quit(0 if failed == 0 else 1)


func _make_image(rel: String, w: int, h: int, base: Color, mode: String, margins: Array) -> Image:
	var col := base
	if rel.contains("shadow") or rel.contains("glow") or rel.contains("hurt_mask"):
		col.a = 0.35

	var img := Image.create(w, h, false, Image.FORMAT_RGBA8)
	img.fill(col)

	var border := col.darkened(0.45)
	border.a = 1.0
	for x in w:
		img.set_pixel(x, 0, border)
		img.set_pixel(x, h - 1, border)
	for y in h:
		img.set_pixel(0, y, border)
		img.set_pixel(w - 1, y, border)

	if mode == "9p" and margins.size() == 4:
		var m := Color(1, 1, 1, 0.55)
		var l := int(float(margins[0]))
		var t := int(float(margins[1]))
		var r := int(float(margins[2]))
		var b := int(float(margins[3]))
		for x in w:
			if t > 0 and t < h:
				img.set_pixel(x, t, m)
			if h - 1 - b > 0:
				img.set_pixel(x, h - 1 - b, m)
		for y in h:
			if l > 0 and l < w:
				img.set_pixel(l, y, m)
			if w - 1 - r > 0:
				img.set_pixel(w - 1 - r, y, m)

	return img


func _write_missing() -> void:
	if FileAccess.file_exists(MISSING_PATH):
		return
	var img := Image.create(128, 128, false, Image.FORMAT_RGBA8)
	var a := Color(1, 0, 1, 1)
	var b := Color(0, 0, 0, 1)
	for y in 128:
		for x in 128:
			img.set_pixel(x, y, a if ((x / 16 + y / 16) % 2 == 0) else b)
	_ensure_dir(ART_ROOT)
	img.save_png(MISSING_PATH)


func _write_markdown(entries: Array) -> void:
	var lines := PackedStringArray()
	lines.append("# ART MANIFEST")
	lines.append("")
	lines.append("Generated by `tools/generate_placeholders.gd` from `docs/art_manifest.json`. Do not edit by hand.")
	lines.append("")
	lines.append("Total assets: **%d**. Sizes are design pixels at 1080×1920. `9p` = 9-slice, margins are `left/top/right/bottom`." % entries.size())
	lines.append("")
	lines.append("| File (under `assets/art/`) | Size | Mode | Margins |")
	lines.append("|---|---|---|---|")
	for raw in entries:
		var e: Dictionary = raw
		var mode: String = str(e.get("mode", "plain"))
		var margins := ""
		if e.has("margins"):
			var m: Array = e["margins"]
			margins = "%d/%d/%d/%d" % [int(float(m[0])), int(float(m[1])), int(float(m[2])), int(float(m[3]))]
		lines.append("| `%s` | %dx%d | %s | %s |" % [str(e.get("path", "")), int(float(e.get("w", 0))), int(float(e.get("h", 0))), mode, margins])
	lines.append("")
	var f := FileAccess.open(MD_PATH, FileAccess.WRITE)
	if f:
		f.store_string("\n".join(lines))
		f.close()


func _ensure_dir(res_path: String) -> void:
	var abs := ProjectSettings.globalize_path(res_path)
	DirAccess.make_dir_recursive_absolute(abs)
